[DLSimModel]
Name=ColorGraph Sample Simulation
TypeFlags=1
_Processor=:CPU73050.dll
_MemoryRAM=:RamCS32B.dll
_MemoryROM=:NOR29GLN2A.dll
_Display=:LCDR61524A.dll
_Keyboard=:Key1616SwA.dll
_PowerInter=:ExtLY755A.dll
_SDCard=:FileSDSimC.dll
_SerialInter=:SerLY755A.dll
_AppIF=:GCalAppIFA.dll
LogErrorAddr=00000000:A4050100.00000100
LogErrorAddr=00000000:FE000000.00400000
LogErrorAddr=00000000:A4080000.00000100
LogErrorAddr=00000000:FFFFFFE0.00000020

[_Processor]
[:Clock]
[Connect]
_MD0=1!1
_MD1=1!1
_XTAL=0
_XTAL_USB=48000000
_XTAL2=32768
[:INT]
[Connect]
_NMI=1!1
[:ADC]
[Connect]
_AN0=_Display:Touch.TXR
_AN1=_MemoryROM:MEM.RYBY
_AN2=_PowerInter:Power.CH3
_AN3=_Display:Touch.TYD
[:PFC]
[Connect]
_PTP0=_Keyboard:Key.KI1
_PTP1=_Keyboard:Key.KI2
_PTP2=_Keyboard:Key.KI3
_PTP3=_Keyboard:Key.KI4
_PTP4=_Keyboard:Key.KI5
_PTP5=_Keyboard:Key.KI6
_PTP6=_Keyboard:Key.KI7
_PTQ0=1!1
_PTQ1=1!1
_PTQ2=1!1
_PTQ3=1!0
_PTR5=_Display:LCD.FMARK
_PTJ3=_SerialInter:RS232.RXD
_PTJ4=1!1:10
_PTJ5=1!1:10
_PTL0=_Display:Touch.TYD
_PTL1=_SerialInter:USB.USB_DET
_PTL2=_SerialInter:RS232.RXD_INT
_PTL3=9!1:7
_PTK4=9!1:4
_PTK5=9!0:4
_PTU1=_SerialInter:USB.USB_DET
_PTB3=9!1:13
_PTF7=9!1:4
[:Power]
[Connect]
_RESETP=_PowerInter:Power.BLD3
[:RAM]
SaveFile=CasioRAMCPU.mem
DefaultFile=INIT\CasioRAMCPUInit.mem
[:RTC]
[Control]
_SystemTime=1
[:USB]
[Connect]
_D_RX=_SerialInter:USB.D_RX
[:FLCTL]
[Control]
_FastMode=0x0F
[:HUDI]
[Control]
_SDIRlow=0x00
[:CPU]
[Control]
_PVR=0x00000000
_PRR=0x00000000
_LowPower=1

[_MemoryRAM]
[:MEM]
BaseAddress=0C000000
BaseAddrIgnore=00800000
SaveFile=CasioRAM.mem
DefaultFile=INIT\CasioRAMInit.mem
[.Addr]
Size=00800000
[Connect]
_CS=_Processor:PFC.PTR2

[_MemoryROM]
[:MEM]
BaseAddress=A0000000
BaseAddrIgnore=00000000
SaveFile=CasioROM.mem
DefaultFile=INIT\CasioROMInit.mem
[.Addr]
Size=00B60000
[Connect]
_CS=_Processor:BSC.CS0
[:User]
BaseAddress=A1000000
BaseAddrIgnore=00000000
SaveFile=CasioUserROM.mem
DefaultFile=INIT\CasioUserROMInit.mem
[.Addr]
Size=014A0000
Offset=00B60000
[Connect]
_CS=_Processor:BSC.CS0

[_Display]
[:LCD]
BaseAddress=14000000
BaseAddrIgnore=00000000
[Control]
_BackImage=X
_LeftPos=0
_Rotate=0
_TopPos=0
_BacklightShift=2
_ID=0x1234
_VCM=0x41
_VDV=0x10
[Connect]
_CS=_Processor:PFC.PTH2
_RS=_Processor:PFC.PTR4
_IM0=1!0
_IM1=_Processor:PFC.PTR6
_IM2=1!0
_IM3=1!0
_RESETX=_Processor:PFC.PTA4
_BLON=1!1
_BLBRIGHT=_Processor:PFC.PTN4
_POWER=_PowerInter:Power.V28SYS
[:Col]
[Control]
_FirstUsed=85
_LastUsed=480
_ColorBGR=0
[:Row]
[Control]
_FirstUsed=321
_LastUsed=98
_Interleaved=1
[:Touch]
[Control]
_LeftPos=0
_RightPos=395
_TopPos=0
_BottomPos=223
_LeftOut=22
_RightOut=22
_TopOut=22
_BottomOut=22
[Connect]
_TXL=_PowerInter:Touch.TXL
_TXR=_PowerInter:Touch.TXR
_TYU=_PowerInter:Touch.TYU
_TYD=_PowerInter:Touch.TYD

[_Keyboard]
[:Key]
[Control]
_KeyDefine=X
_KeyDownImage=X
_KeyImage=X
[Connect]
_KO1=_Processor:PFC.PTM0
_KO2=_Processor:PFC.PTM1
_KO3=_Processor:PFC.PTM2
_KO4=_Processor:PFC.PTM3
_KO5=_Processor:PFC.PTM4
_KO6=_Processor:PFC.PTM5
_KO7=_Processor:PFC.PTN0
_KO8=_Processor:PFC.PTN1
_KO9=_Processor:PFC.PTN2
_KO10=_Processor:PFC.PTN3
_KO12=_Processor:PFC.PTN5

[_PowerInter]
[:Power]
[Control]
_Bat=5.6
[Connect]
_USBPW=_SerialInter:USB.USBPW
_Reset=_Keyboard:Key.SW0A
_POWERON=_Processor:PFC.PTJ6
_DDPOWER=_Processor:PFC.PTH5
[:Touch]
[Connect]
_TPO1=_Processor:PFC.PTG0
_TPO2=_Processor:PFC.PTG1
_TPO3=_Processor:PFC.PTG2
_TPO4=_Processor:PFC.PTG3
_TPO5=_Processor:PFC.PTG4
_TPO6=_Processor:PFC.PTG5
_TPO7=_Processor:PFC.PTG6
_TPO8=_Processor:PFC.PTG7
_TouchOn=_Processor:PFC.PTH4

[_SDCard]
[:SD]
[Control]
_BasePath=SDCard

[_SerialInter]
[:USB]
[Connect]
_D_TX=_Processor:USB.D_TX
[:RS232]
[Connect]
_TXD=_Processor:PFC.PTJ2
_TXD_ENE=_Processor:PFC.PTU2
_RXD_ENE=_Processor:PFC.PTU3
[Control]
_ComNum=1

[_AppIF]
[:App]
[Connect]
_CS=_Processor:PFC.PTR3

